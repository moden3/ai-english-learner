#!/usr/bin/env bash
#MISE description="Run pre-commit checks (format check, linters, type checks, and security checks)"
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

echo "🔍 [1/5] Running secret & artifact leak check..."
cd "$PROJECT_ROOT"
if git rev-parse --verify HEAD >/dev/null 2>&1; then
    STAGED_FILES=$(git diff --cached --name-only)
    if echo "$STAGED_FILES" | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example' >/dev/null; then
        echo "❌ Error: Attempting to commit a .env file! Please unstage it."
        exit 1
    fi
    if echo "$STAGED_FILES" | grep -E '\.(tfstate|tfstate\.backup|zip)$' >/dev/null; then
        echo "❌ Error: Attempting to commit terraform state or zip artifacts! Please unstage them."
        exit 1
    fi
fi

echo "🎨 [2/5] Running format checks (mise run fmt --check)..."
mise run fmt --check

echo "🦀 [3/5] Running Rust linter (cargo clippy)..."
cd "$PROJECT_ROOT/backend"
cargo clippy --all-targets -- -D warnings

echo "☁️ [4/5] Validating Terraform configuration (terraform validate)..."
cd "$PROJECT_ROOT/backend/infra"
terraform validate

echo "⚛️ [5/5] Running Frontend linter & TypeScript type check..."
cd "$PROJECT_ROOT/frontend"
npm run lint
npx tsc -b --noEmit

echo "✅ All pre-commit checks passed!"
