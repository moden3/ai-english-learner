#!/usr/bin/env bash
#MISE description="Run backend tests with terminal and HTML coverage reports"
set -euo pipefail

cd backend
echo "🧪 Running backend tests with code coverage..."
# Clear local/CI override env vars during unit tests so SSM mock fallback tests run deterministically
unset APP_API_KEY GEMINI_API_KEY TAVILY_API_KEY
cargo llvm-cov --workspace "$@"
cargo llvm-cov report --html
echo "📄 HTML coverage report generated at: backend/target/llvm-cov/html/index.html"
